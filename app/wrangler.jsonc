{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aint",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "build": {
    "command": "node scripts/gen-build-info.mjs"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY_EVENTS",
      "dataset": "aint_requests"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEMETRY",
        "class_name": "TelemetryCounters"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TelemetryCounters"]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
